# Name of this node in client profiles and alerts.
NODE_NAME=home

# Public IP or domain of this node. Required by the Reality and Hysteria2 lanes.
PUBLIC_HOST=

# Reality lane (TCP). Leave empty to disable. The port must be forwarded to this host.
REALITY_PORT=443
# The site Reality impersonates: a TLS 1.3 site reachable from this host.
REALITY_SNI=www.microsoft.com

# Hysteria2 lane (UDP). Leave empty to disable. The port must be forwarded to this host.
HY2_PORT=443
# Optional UDP range redirected to HY2_PORT (Linux host only), e.g. 20000-40000.
# The whole range must be forwarded to this host too.
HY2_HOP_PORTS=

# Cloudflare lane: token of a tunnel whose public hostname is CF_HOSTNAME. No port to open.
CF_TUNNEL_TOKEN=
CF_HOSTNAME=

# Telegram alerts. Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Other nodes to watch, comma separated: tcp://host:port,https://tunnel.example.com
WATCH_PEERS=
WATCH_INTERVAL=60
