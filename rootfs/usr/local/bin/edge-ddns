#!/usr/bin/env bash
# Keeps the Cloudflare A record named PUBLIC_HOST on this node's public IPv4, so a home connection
# whose address changes stays reachable. The record is created DNS only (not proxied): Reality and
# Hysteria2 must reach the node itself, not Cloudflare's proxy.
#
# Needs DDNS_CF_API_TOKEN (permission Zone > DNS > Edit on the zone) and DDNS_CF_ZONE_ID.
# `edge-ddns once` runs a single update and exits.
set -uo pipefail

API=https://api.cloudflare.com/client/v4
INTERVAL=${DDNS_INTERVAL:-300}

log() { printf '%s edge-ddns: %s\n' "$(date -u +%FT%TZ)" "$*" >&2; }

cf() {
  local method=$1 path=$2
  shift 2
  curl -fsS --max-time 15 -X "$method" "$API$path" \
    -H "Authorization: Bearer $DDNS_CF_API_TOKEN" -H 'Content-Type: application/json' "$@"
}

public_ip() {
  curl -fsS --max-time 10 https://1.1.1.1/cdn-cgi/trace | sed -n 's/^ip=//p'
}

update() {
  local ip record id current body
  ip=$(public_ip) || {
    log "cannot read the public IP"
    return 1
  }
  [[ $ip =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
    log "public IP $ip is not IPv4, skipping"
    return 1
  }
  record=$(cf GET "/zones/$DDNS_CF_ZONE_ID/dns_records?type=A&name=$PUBLIC_HOST") || {
    log "cannot read the record $PUBLIC_HOST"
    return 1
  }
  id=$(jq -r '.result[0].id // empty' <<<"$record")
  current=$(jq -r '.result[0].content // empty' <<<"$record")
  [ "$current" = "$ip" ] && return 0

  body=$(jq -nc --arg name "$PUBLIC_HOST" --arg ip "$ip" \
    '{type: "A", name: $name, content: $ip, ttl: 60, proxied: false}')
  if [ -z "$id" ]; then
    cf POST "/zones/$DDNS_CF_ZONE_ID/dns_records" --data "$body" >/dev/null &&
      log "created $PUBLIC_HOST -> $ip"
  else
    cf PATCH "/zones/$DDNS_CF_ZONE_ID/dns_records/$id" --data "$body" >/dev/null &&
      log "updated $PUBLIC_HOST: $current -> $ip"
  fi
}

for var in DDNS_CF_API_TOKEN DDNS_CF_ZONE_ID PUBLIC_HOST; do
  [ -n "${!var:-}" ] || {
    log "$var is required"
    exit 1
  }
done

if [ "${1:-}" = once ]; then
  update
  exit
fi
while true; do
  update
  sleep "$INTERVAL"
done
